# ==============================================================================
# PERFORMANS & PROJE GÖREV TAKİP SİSTEMİ - ÇEVRE DEĞİŞKENLERİ ŞABLONU (.env.example)
# Bu dosyayı .env olarak kopyalayıp gerçek değerlerinizi giriniz.
# DİKKAT: .env dosyasını ve gizli anahtarları asla Git deposuna eklemeyiniz!
# ==============================================================================

# Uygulama Temel URL'si
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. SUPABASE YAPILANDIRMASI (İstemci & Sunucu)
# ------------------------------------------------------------------------------
# Supabase Proje URL'si (Dashboard -> Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon/Public Key (Tarayıcıda kullanım için güvenlidir, RLS ile korunur)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SADECE Sunucu/Backend ortamında kullanılır!)
# ASLA tarayıcıya veya istemci koduna (VITE_ prefix ile) maruz BIRAKMAYINIZ!
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 2. E-POSTA / SMTP YAPILANDIRMASI (Bildirimler ve Gecikme Uyarıları için)
# Supabase Auth e-posta doğrulama haricindeki sistem e-postaları için kullanılır.
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.ornekokul.k12.tr"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="gorevtakip@ornekokul.k12.tr"
SMTP_PASS="guclu_smtp_sifresi"
SMTP_FROM="Performans & Proje Takip <gorevtakip@ornekokul.k12.tr>"

# ------------------------------------------------------------------------------
# 3. DOSYA YÜKLEME VE GÜVENLİK SINIRLARI
# ------------------------------------------------------------------------------
# Öğrenci PDF teslim limiti (Bayt cinsinden: 15 MB = 15728640)
MAX_STUDENT_FILE_SIZE_BYTES=15728640

# Öğretmen kaynak dosya limiti (Bayt cinsinden: 20 MB = 20971520)
MAX_TEACHER_FILE_SIZE_BYTES=20971520

# Oturum hareketsizlik aşımı (Dakika)
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
